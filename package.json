{
  "name": "destructure",
  "version": "0.0.1-alpha.0",
  "description": "A library for serialisation and deserialisation of structured data.",
  "homepage": "https://github.com/1natsie/destructure#readme",
  "author": "Oghenevwegba Obire",
  "license": "MIT",
  "keywords": [
    "destructure",
    "serialisation",
    "binary-data",
    "memory-manipulation",
    "buffer"
  ],
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.js",
    "build:watch": "node ./scripts/build-watch.js",
    "dev": "node ./scripts/dev.js"
  },
  "files": [
    "dist/",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./decode": {
      "import": "./dist/decoder.js",
      "types": "./dist/decoder.d.ts"
    },
    "./encode": {
      "import": "./dist/encoder.js",
      "types": "./dist/encoder.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    }
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/1natsie/destructure/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1natsie/destructure.git"
  }
}
